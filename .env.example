# ── Neon ────────────────────────────────────────────────────────────────────
# Neon Console > your project > Connection string > psycopg / "Pooled connection"
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000
# Comma-separated origins allowed to call this API (the Vite dev server, then
# whatever host the built site ends up on).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Long random string. Guards every /api/admin/* route.
ADMIN_TOKEN=change-me-to-something-long-and-random

# ── The subscription ────────────────────────────────────────────────────────
SUBSCRIPTION_PRICE_INR=499
# "Automatic" | "Open now" | "Closed" — Automatic opens the 20th, closes the 2nd
SIGNUP_WINDOW=Automatic

# ── Razorpay ────────────────────────────────────────────────────────────────
# Leave both empty until the account is approved. While they are empty the API
# reports payments as unavailable and the site says so instead of taking money.
# Dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks — used to verify webhook signatures.
RAZORPAY_WEBHOOK_SECRET=
