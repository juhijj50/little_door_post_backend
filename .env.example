# ── Neon ────────────────────────────────────────────────────────────────────
# Neon Console > your project > Connection string. The postgresql+psycopg://
# form Neon offers for SQLAlchemy works too — the scheme is normalised.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Server ──────────────────────────────────────────────────────────────────
# Exact origins allowed to call the API, comma-separated. Scheme included,
# NO trailing slash, no path — a browser sends "https://site.com" as its
# Origin, never "https://site.com/". (One is stripped if you leave it on.)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Long random string. Guards every /api/admin/* route.
ADMIN_TOKEN=change-me-to-something-long-and-random

# ── Reminders ───────────────────────────────────────────────────────────────
# Somebody arriving while sign-ups are shut can ask to be nudged. The request is
# always saved (read it at /api/admin/reminders); these settings only decide
# whether it also emails you.
# Gmail needs an APP PASSWORD, not your account password:
#   Google Account > Security > 2-Step Verification > App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# Where the notification goes. Defaults to EMAIL_USER if left blank.
EMAIL_TO=

# ── Brevo (needed on Render's FREE tier) ────────────────────────────────────
# Render's free tier blocks outbound SMTP — ports 25, 465 and 587 — so the
# Gmail settings above cannot send from there, however right the password is.
# Brevo sends over HTTPS instead, which is not blocked. When BREVO_API_KEY is
# set it is used in preference to SMTP.
#   1. Sign up at brevo.com (free: plenty for order notifications)
#   2. Senders, Domains & Dedicated IPs > Senders > add and verify the address
#      below — a Gmail address is fine, no domain needed
#   3. SMTP & API > API Keys > generate one, paste it here
# Then check it on the live server: POST /api/admin/test-email
# On a PAID Render instance SMTP works, and none of this is needed.
BREVO_API_KEY=
EMAIL_FROM=

# ── Razorpay ────────────────────────────────────────────────────────────────
# Leave empty until the account is approved. While empty, sign-ups are saved
# and the site says checkout is not live yet — nothing can be charged.
# Dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks — a secret you invent, pasted on both sides.
RAZORPAY_WEBHOOK_SECRET=

# Note: the port comes from uvicorn --port (and Render sets $PORT itself).
# Prices live in the `plans` table and sign-up windows in `cycles`, so both are
# changed in the database, not here.
